# Copy these values into your local environment or deployment dashboard.
# Never commit real credentials.

# Brevo (smtp-relay.brevo.com) SMTP relay
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-password
MAIL_DEFAULT_SENDER=your-verified-sender@example.com
# Set to True in development to log SMTP traffic; omit or set False in production
MAIL_DEBUG=False
